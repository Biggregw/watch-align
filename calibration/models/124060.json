{
  "model": "124060",
  "family": "submariner_12",
  "acquisition_adapter": "submariner_acquire_v2",
  "measurement_adapter": "submariner_research_v2",
  "layout": {
    "triangle": [12],
    "batons": [3, 6, 9],
    "rounds": [1, 2, 4, 5, 7, 8, 10, 11]
  },
  "replica_factories": ["VSF", "Clean", "CF", "ARF"],
  "variants": "orig,s94,s88,x+1,x-1,x+2,x-2,y+1,y-1,y+2,y-2,r+5,r-5",
  "shards": 4,
  "discovery": {
    "target_gen": 28,
    "target_rep": 16,
    "minimum_gen_candidates": 12,
    "per_source_target": 10,
    "max_images_per_watch": 10,
    "bootstrap_pool_globs": [
      "docs/research/submariner_candidate_sources_2026-09-30.csv",
      "docs/research/submariner_*topup*.csv"
    ],
    "sources": [
      {
        "class": "gen",
        "domain": "bobswatches.com",
        "name": "Bob's Watches",
        "id_prefix": "auto_bobs_124060",
        "source_type": "dealer_listing",
        "target": 14,
        "require_listing_id": true,
        "queries": [
          "site:bobswatches.com Rolex {model}",
          "site:bobswatches.com Submariner {model}",
          "site:bobswatches.com {model} black dial"
        ]
      },
      {
        "class": "gen",
        "domain": "swisswatchexpo.com",
        "name": "SwissWatchExpo",
        "id_prefix": "auto_swe_124060",
        "source_type": "dealer_listing",
        "target": 8,
        "require_listing_id": true,
        "queries": [
          "site:swisswatchexpo.com Rolex {model}",
          "site:swisswatchexpo.com Submariner {model}"
        ]
      },
      {
        "class": "gen",
        "domain": "watchfinder.co.uk",
        "name": "Watchfinder",
        "id_prefix": "auto_watchfinder_124060",
        "source_type": "dealer_listing",
        "target": 6,
        "queries": [
          "site:watchfinder.co.uk Rolex {model}",
          "site:watchfinder.co.uk Submariner {model}"
        ]
      },
      {
        "class": "rep",
        "domain": "reddit.com",
        "name": "r/RepTimeQC",
        "id_prefix": "auto_reptimeqc_124060",
        "source_type": "forum_qc",
        "target": 16,
        "require_album": true,
        "require_factory": true,
        "queries": [
          "site:reddit.com/r/RepTimeQC {model} VSF imgur",
          "site:reddit.com/r/RepTimeQC {model} Clean imgur",
          "site:reddit.com/r/RepTimeQC {model} CF imgur",
          "site:reddit.com/r/RepTimeQC Rolex {model} QC imgur"
        ]
      }
    ]
  },
  "calibration_policy": {
    "min_development_watches": 6,
    "min_validation_watches": 2,
    "min_holdout_watches": 2,
    "clear_sigma": 3.0,
    "check_sigma": 5.0,
    "check_over_clear": 1.5,
    "validation_clear_rate_min": 0.75,
    "validation_check_rate_min": 1.0,
    "holdout_clear_rate_min": 0.75,
    "holdout_check_rate_min": 1.0
  },
  "calibration_metrics": [
    {
      "metric": "t12_surround_rotation_deg",
      "app_key": "twelve.rotation_deg",
      "minimum_half_width": 0.20,
      "allow_pose_sensitive": false
    },
    {
      "metric": "t12_surround_gap_to_track_r",
      "app_key": "twelve.gap_r",
      "minimum_half_width": 0.002,
      "allow_pose_sensitive": false
    },
    {
      "metric": "t12_surround_lateral_offset_from_60tick_w",
      "app_key": "twelve.centring_w",
      "minimum_half_width": 0.01,
      "allow_pose_sensitive": false
    },
    {
      "metric": "ring_round_rho_median",
      "app_key": "round.ring_rho",
      "minimum_half_width": 0.002,
      "allow_pose_sensitive": false
    },
    {
      "metric": "ring_round_spacing_rms_deg",
      "app_key": "round.spacing_rms_deg",
      "minimum_half_width": 0.10,
      "allow_pose_sensitive": false
    },
    {
      "metric": "b3_b9_line_centre_offset_r",
      "app_key": "baton.3_9_line_offset_r",
      "minimum_half_width": 0.002,
      "allow_pose_sensitive": false
    },
    {
      "metric": "t12_b6_line_centre_offset_r",
      "app_key": "axis.12_6_line_offset_r",
      "minimum_half_width": 0.002,
      "allow_pose_sensitive": false
    }
  ]
}
